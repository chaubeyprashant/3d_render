<?xml version="1.0" encoding="utf-8"?><!--
   Auto-backup rules for Android 11 and lower.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- Session tokens must not be restored onto another device. -->
    <exclude domain="sharedpref" path="auth_prefs.xml" />
    <!-- Offline project copies can be hundreds of MB and are re-fetched on demand. -->
    <exclude domain="file" path="projects/" />
</full-backup-content>
